[Unit]
Description=Resonance terminal EQ daemon (PipeWire)
Documentation=https://github.com/ealtun21/resonance
# Start after the user PipeWire stack is up.
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire.service

[Service]
Type=simple
ExecStart=%h/.local/bin/resonanced
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=2
# resonanced writes its own pidfile + socket under $XDG_RUNTIME_DIR and cleans
# them up on SIGTERM, so a plain simple service is enough.
KillSignal=SIGTERM
TimeoutStopSec=5

[Install]
WantedBy=default.target
